# ------------------------------------------------------------------------------
# Actual version override. Update this values and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# ACTUAL_VERSION=latest

# ------------------------------------------------------------------------------
# The Actual server port to be exposed to the host.
# ------------------------------------------------------------------------------

# ACTUAL_PORT=5006

# ------------------------------------------------------------------------------
# Volume in which Actual data will be stored. This may be a path to a directory
# on the host (absolue or relative to the 'docker-compose.yaml' file) or the
# name of a Docker volume. Used the internal 'actual-data' volume by default.
# ------------------------------------------------------------------------------

# ACTUAL_DATA_VOLUME=actual-data
